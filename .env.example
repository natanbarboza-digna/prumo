# Copy to .env (development) and .env.test (tests). Never commit the copies.

# Used by docker-compose.yml to create the Postgres container.
POSTGRES_USER=prumo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prumo

# Used by Prisma and the app.
# In .env.test, point to the test database: .../prumo_test
DATABASE_URL="postgresql://prumo:change-me@localhost:5432/prumo?schema=public"
