# Copy to .env (development) and .env.test (tests). Never commit the copies.

# Used by docker-compose.yml to create the Postgres container.
POSTGRES_USER=personal_management
POSTGRES_PASSWORD=change-me
POSTGRES_DB=personal_management

# Used by Prisma and the app.
# In .env.test, point to the test database: .../personal_management_test
DATABASE_URL="postgresql://personal_management:change-me@localhost:5432/personal_management?schema=public"
