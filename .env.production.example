# Copy to .env.production on the server (never commit the copy). See docs/deploy.md.

# Database credentials. Use a long random password, e.g.: openssl rand -base64 32
POSTGRES_USER=prumo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prumo

# --- Without a domain: the app by the server's IP over plain HTTP (plan 039) ---
# Server port the app answers on (default 80, so the address is http://SERVER-IP).
# APP_PORT=80
# Browsers only keep a Secure cookie over HTTPS, so logging in by IP needs "false".
# RISK: password and session travel unencrypted. Use it only until there is a
# domain, and remove this line when Caddy is on.
# SESSION_COOKIE_SECURE=false

# --- With a domain: docker-compose.caddy.yml adds HTTPS ---
# Domain pointing to the server (DNS A/AAAA record) and the email Let's Encrypt
# uses for certificate notices.
# DOMAIN=prumo.exemplo.com
# ACME_EMAIL=voce@exemplo.com
