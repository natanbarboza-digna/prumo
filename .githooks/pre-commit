#!/bin/sh
# Runs before every commit (enabled by `npm install`, see "prepare" in package.json).
# Only Prettier: the message does not exist yet, so lint, types and unit tests
# run in commit-msg, which knows the commit type (plan 038).

echo "pre-commit: formatação (Prettier)"
if ! npm run --silent format:check; then
  echo ""
  echo "pre-commit: \"formatação (Prettier)\" falhou. Rode npm run format e tente o commit de novo."
  echo "Só em emergência: git commit --no-verify (o CI vai conferir do mesmo jeito)."
  exit 1
fi
