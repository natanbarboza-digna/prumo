{
  "name": "prumo",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    },
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "prepare": "node scripts/enable-git-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test -c playwright.dev.config.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "check:versions": "tsx scripts/check-pinned-versions.ts",
    "pdi:template": "tsx scripts/generate-pdi-template.ts",
    "auth:create-user": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.17",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "semver": "7.8.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
