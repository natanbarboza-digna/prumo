// Prisma schema: https://pris.ly/d/prisma-schema
// Models are added feature by feature, each through an approved plan (docs/plans).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions: UUID v7 ids (unique and sortable by creation time) and
// snake_case names in the database via @map/@@map, camelCase in TypeScript.

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ARCHIVED

  @@map("goal_status")
}

model Goal {
  id          String      @id @default(uuid(7)) @db.Uuid
  title       String      @db.VarChar(120)
  description String?
  status      GoalStatus  @default(NOT_STARTED)
  targetDate  DateTime?   @map("target_date") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  tracks      Track[]
  routines    Routine[]
  pdiActions  PdiAction[]
  books       Book[]

  @@index([status])
  @@map("goals")
}

enum TrackStepStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE

  @@map("track_step_status")
}

model Track {
  id          String      @id @default(uuid(7)) @db.Uuid
  title       String      @db.VarChar(120)
  description String?
  goalId      String?     @map("goal_id") @db.Uuid
  // Deleting a goal keeps its tracks and only clears the link.
  goal        Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  steps       TrackStep[]
  /// When the track was archived (plan 024); null while it is active.
  archivedAt  DateTime?   @map("archived_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([goalId])
  @@map("tracks")
}

model TrackStep {
  id          String          @id @default(uuid(7)) @db.Uuid
  trackId     String          @map("track_id") @db.Uuid
  track       Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title       String          @db.VarChar(160)
  // "order" is an SQL reserved word, so the column is named "position".
  order       Int             @map("position")
  status      TrackStepStatus @default(NOT_STARTED)
  dueDate     DateTime?       @map("due_date") @db.Date
  resourceUrl String?         @map("resource_url") @db.VarChar(2000)
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([trackId, order])
  @@map("track_steps")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN

  @@map("weekday")
}

enum RoutineLogStatus {
  DONE
  SKIPPED

  @@map("routine_log_status")
}

model Routine {
  id           String       @id @default(uuid(7)) @db.Uuid
  title        String       @db.VarChar(120)
  description  String?
  // Days of the week the routine applies to (a native Postgres enum array).
  weekdays     Weekday[]
  // "HH:MM" text: a TIME column would come back from Prisma as a Date with an
  // artificial day and time zone.
  timeOfDay    String?      @map("time_of_day") @db.VarChar(5)
  /// Weekly goal (plan 017): how many days per week, 1 to 6. Null for a
  /// fixed-days routine. A weekly-goal routine stores all 7 days in `weekdays`.
  timesPerWeek Int?         @map("times_per_week") @db.SmallInt
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime?    @map("end_date") @db.Date
  goalId       String?      @map("goal_id") @db.Uuid
  goal         Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  // Set when the routine was created from a PDI action; deleting the action
  // keeps the routine, unlinked.
  pdiActionId  String?      @map("pdi_action_id") @db.Uuid
  pdiAction    PdiAction?   @relation(fields: [pdiActionId], references: [id], onDelete: SetNull)
  logs         RoutineLog[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([goalId])
  @@index([pdiActionId])
  @@map("routines")
}

model RoutineLog {
  id        String           @id @default(uuid(7)) @db.Uuid
  routineId String           @map("routine_id") @db.Uuid
  routine   Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    RoutineLogStatus
  note      String?          @db.VarChar(500)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // One log per routine per day; logging again replaces it.
  @@unique([routineId, date])
  @@map("routine_logs")
}

enum PdiCycleStatus {
  PLANNED
  ACTIVE
  CLOSED

  @@map("pdi_cycle_status")
}

enum PdiActionStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("pdi_action_status")
}

model ActionCategory {
  id            String      @id @default(uuid(7)) @db.Uuid
  name          String      @unique @db.VarChar(60)
  allowsRoutine Boolean     @default(false) @map("allows_routine")
  archived      Boolean     @default(false)
  actions       PdiAction[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("action_categories")
}

model PdiCycle {
  id              String         @id @default(uuid(7)) @db.Uuid
  title           String         @db.VarChar(120)
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  status          PdiCycleStatus @default(PLANNED)
  managerName     String?        @map("manager_name") @db.VarChar(120)
  careerObjective String?        @map("career_objective")
  selfAssessment  String?        @map("self_assessment")
  managerFeedback String?        @map("manager_feedback")
  finalRating     String?        @map("final_rating") @db.VarChar(60)
  areas           PdiArea[]
  checkIns        PdiCheckIn[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("pdi_cycles")
}

model PdiArea {
  id              String      @id @default(uuid(7)) @db.Uuid
  cycleId         String      @map("cycle_id") @db.Uuid
  cycle           PdiCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name            String      @db.VarChar(120)
  description     String?
  expectedOutcome String?     @map("expected_outcome")
  /// Manual order inside the cycle, 1, 2, 3… (plan 021). "order" is an SQL reserved word.
  order           Int         @map("position")
  actions         PdiAction[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([cycleId, order])
  @@map("pdi_areas")
}

model PdiAction {
  id             String          @id @default(uuid(7)) @db.Uuid
  areaId         String          @map("area_id") @db.Uuid
  area           PdiArea         @relation(fields: [areaId], references: [id], onDelete: Cascade)
  categoryId     String          @map("category_id") @db.Uuid
  category       ActionCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String          @db.VarChar(160)
  description    String?
  expectedResult String?         @map("expected_result")
  dueDate        DateTime?       @map("due_date") @db.Date
  status         PdiActionStatus @default(NOT_STARTED)
  evidence       String?
  managerComment String?         @map("manager_comment")
  /// Manual order inside the area, 1, 2, 3… (plan 021).
  order          Int             @map("position")
  goalId         String?         @map("goal_id") @db.Uuid
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  routines       Routine[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([areaId, order])
  @@index([categoryId])
  @@index([goalId])
  @@map("pdi_actions")
}

model PdiCheckIn {
  id           String   @id @default(uuid(7)) @db.Uuid
  cycleId      String   @map("cycle_id") @db.Uuid
  cycle        PdiCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  summary      String
  nextSteps    String?  @map("next_steps")
  managerNotes String?  @map("manager_notes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([cycleId, date])
  @@map("pdi_check_ins")
}

// ---------------------------------------------------------------------------
// Authentication (plan 014): a single account protects access to everything.
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Always stored in lowercase.
  email            String    @unique @db.VarChar(254)
  /// scrypt hash with its salt and parameters (see src/modules/auth/password.ts).
  passwordHash     String    @map("password_hash")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  sessions         Session[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Time tracking (plan 031). Times of day are minutes since midnight (Int), in
// the app's time zone, and travel through the app as "HH:MM".
// ---------------------------------------------------------------------------

enum TimeEntryKind {
  WORK
  BREAK

  @@map("time_entry_kind")
}

/// One day of time tracking: when it started and ended, and the block size.
model TimeDay {
  id          String      @id @default(uuid(7)) @db.Uuid
  date        DateTime    @unique @db.Date
  startMinute Int         @map("start_minute")
  /// Null while the day is open.
  endMinute   Int?        @map("end_minute")
  /// 15, 30 or 60, chosen when the day starts.
  slotMinutes Int         @map("slot_minutes")
  entries     TimeEntry[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("time_days")
}

/// A block (or half a block) of a day: work with a category, or a break.
model TimeEntry {
  id          String        @id @default(uuid(7)) @db.Uuid
  dayId       String        @map("day_id") @db.Uuid
  day         TimeDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  startMinute Int           @map("start_minute")
  minutes     Int
  kind        TimeEntryKind
  description String?       @db.VarChar(300)
  /// Required for WORK, null for BREAK.
  categoryId  String?       @map("category_id") @db.Uuid
  category    TimeCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projectId   String?       @map("project_id") @db.Uuid
  project     TimeProject?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([dayId, startMinute])
  @@index([categoryId])
  @@index([projectId])
  @@map("time_entries")
}

model TimeCategory {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String      @unique @db.VarChar(60)
  archived  Boolean     @default(false)
  entries   TimeEntry[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("time_categories")
}

model TimeProject {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String      @unique @db.VarChar(80)
  archived  Boolean     @default(false)
  entries   TimeEntry[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("time_projects")
}

// Book library (plan 035). "Preciso ler" is a book in the queue whose reason is
// WORK or PDI; "quero ler", one whose reason is PERSONAL or RECOMMENDATION.

enum BookStatus {
  TO_READ
  READING
  READ
  ABANDONED

  @@map("book_status")
}

enum BookReason {
  PERSONAL
  RECOMMENDATION
  WORK
  PDI

  @@map("book_reason")
}

enum BookFormat {
  PHYSICAL
  EBOOK
  AUDIOBOOK

  @@map("book_format")
}

model Book {
  id              String      @id @default(uuid(7)) @db.Uuid
  title           String      @db.VarChar(200)
  authors         String      @db.VarChar(200)
  format          BookFormat  @default(PHYSICAL)
  pages           Int?
  genre           String?     @db.VarChar(60)
  recommendedBy   String?     @map("recommended_by") @db.VarChar(120)
  notes           String?
  status          BookStatus  @default(TO_READ)
  reason          BookReason  @default(PERSONAL)
  /// Only for required books (WORK or PDI).
  dueDate         DateTime?   @map("due_date") @db.Date
  startedOn       DateTime?   @map("started_on") @db.Date
  finishedOn      DateTime?   @map("finished_on") @db.Date
  goalId          String?     @map("goal_id") @db.Uuid
  // Deleting a goal keeps its books and only clears the link.
  goal            Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// Audiobook length (plan 036).
  durationMinutes Int?        @map("duration_minutes")
  /// 1 to 5, only for a read book (plan 036).
  rating          Int?        @db.SmallInt
  review          String?
  logs            BookLog[]
  quotes          BookQuote[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("books")
}

// Reading progress (plan 036): one log per book and day, with the position
// reached (page, percentage or minutes, by the book's format).
model BookLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bookId, date])
  @@map("book_logs")
}

model BookQuote {
  id        String   @id @default(uuid(7)) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  text      String
  /// Page, percentage or "HH:MM", as typed.
  location  String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bookId])
  @@map("book_quotes")
}
